# StudentPathOS Frontend Environment Variables
# Copy this file to .env and fill in your values after CDK deployment

# API Gateway REST API URL
VITE_API_URL=https://xxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Cognito User Pool Configuration
VITE_USER_POOL_ID=us-east-1_XXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXX
VITE_USER_POOL_REGION=us-east-1

# AppSync GraphQL API
VITE_GRAPHQL_URL=https://xxxxx.appsync-api.us-east-1.amazonaws.com/graphql

# AWS Region
VITE_REGION=us-east-1

# Optional: Analytics
VITE_ENABLE_ANALYTICS=true
